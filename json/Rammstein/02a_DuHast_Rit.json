        "+3dB": 1,
        "Bright": 1
      }
    },
    "DRV": {
      "enabled": true,
      "effect": "Scream",
      "parameters": {
        "Gain": 14,
        "Tone": 62,
        "Vol": 76
      }
    },
    "AMP": {
      "enabled": true,
      "effect": "Brit 800",
      "parameters": {
        "Gain": 64,
        "Pres": 58,
        "Vol": 84,
        "Bass": 48,
        "Middle": 48,
        "Treble": 68
      }
    },
