{
  "version": "1.0",
  "presetName": "BlckSab R",
  "description": "Black Sabbath: doomy tritone riff, boosted mid-forward",
  "ampMode": "Normal",
  "presetVolume": 30,
  "modules": {
    "NR": {
      "enabled": true,
      "effect": "Gate",
      "parameters": {
        "THRE": 10
      }
    },
    "FX1": {
      "enabled": true,
      "effect": "Boost",
      "parameters": {
        "Gain": 48,
        "+3dB": 1,
        "Bright": 1
      }
    },
    "DRV": {
      "enabled": false,
      "effect": "Scream",
      "parameters": {
        "Gain": 40,
        "Tone": 70,
        "Vol": 50
      }
    },
    "AMP": {
      "enabled": true,
      "effect": "Brit 800",
      "parameters": {
        "Gain": 58,
        "Pres": 52,
        "Vol": 80,
        "Bass": 60,
        "Middle": 60,
        "Treble": 52
      }
    },
    "IR": {
      "enabled": true,
      "effect": "BritGN 4x12",
      "parameters": {
        "Vol": 85
      }
    },
    "EQ": {
      "enabled": true,
      "effect": "GT EQ 1",
      "parameters": {
        "125Hz": 6,
        "400Hz": 8,
        "800Hz": 10,
        "1.6kHz": 4,
        "4kHz": -2,
        "Vol": 50
      }
    },
    "FX2": {
      "enabled": false,
      "effect": "Boost",
      "parameters": {
        "Gain": 20,
        "+3dB": 1,
        "Bright": 1
      }
    },
    "DLY": {
      "enabled": false,
      "effect": "Pure",
      "parameters": {
        "Mix": 20,
        "Time": 500,
        "F.Back": 30
      }
    },
    "RVB": {
      "enabled": true,
      "effect": "Hall",
      "parameters": {
        "Mix": 16,
        "Decay": 50
      }
    }
  },
  "signalChain": [
    "NR",
    "FX1",
    "DRV",
    "AMP",
    "IR",
    "EQ",
    "FX2",
    "DLY",
    "RVB"
  ],
  "metadata": {
    "createdDate": "2026-08-18",
    "author": "PocketEdit",
    "tags": []
  }
