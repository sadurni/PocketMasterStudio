        "+3dB": 0,
        "Bright": 1
      }
    },
    "DRV": {
      "enabled": true,
      "effect": "Scream",
      "parameters": {
        "Gain": 30,
        "Tone": 62,
        "Vol": 57
      }
    },
    "AMP": {
      "enabled": true,
      "effect": "Brit 45",
      "parameters": {
        "Gain": 63,
        "Pres": 60,
        "Vol": 84,
        "Bass": 44,
        "Middle": 68,
        "Treble": 65
      }
    },
    "IR": {
      "enabled": true,
