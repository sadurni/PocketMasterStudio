{
  "version": "1.0",
  "presetName": "Sunbathr H",
  "description": "Sunbather: euphoric tremolo wall + huge reverb  [Sub.: solo -> Dream House]",
  "ampMode": "Clone",
  "presetVolume": 100,
  "modules": {
    "NR": {
      "enabled": true,
      "effect": "Gate",
      "parameters": {
        "THRE": 20
      }
    },
    "FX1": {
      "enabled": false,
      "effect": "Boost",
      "parameters": {
        "Gain": 20,
        "+3dB": 1,
        "Bright": 1
      }
    },
    "DRV": {
      "enabled": true,
      "effect": "Scream",
      "parameters": {
        "Gain": 30,
        "Tone": 60,
        "Vol": 72
      }
    },
    "IR": {
      "enabled": true,
      "effect": "Dizzy 4x12",
      "parameters": {
        "Vol": 100
      }
    },
    "EQ": {
      "enabled": true,
      "effect": "GT EQ 1",
      "parameters": {
        "125Hz": 0,
        "400Hz": 0,
        "800Hz": 0,
        "1.6kHz": 0,
        "4kHz": 0,
        "Vol": 100
      }
    },
    "FX2": {
      "enabled": false,
      "effect": "Boost",
      "parameters": {
        "Gain": 20,
        "+3dB": 1,
        "Bright": 1
      }
    },
    "DLY": {
      "enabled": true,
      "effect": "Analog",
      "parameters": {
        "Mix": 26,
        "Time": 380,
        "F.Back": 40
      }
    },
    "RVB": {
      "enabled": true,
      "effect": "Dream",
      "parameters": {
        "Mix": 30,
        "Decay": 74,
        "Damp": 50,
        "Mod": 45
      }
    },
    "Clone": {
      "enabled": true,
      "effect": "SoloSLO",
      "parameters": {
        "Gain": 50,
        "Vol": 100,
        "Bass": 50,
        "Middle": 50,
        "Treble": 50
      }
    }
  },
  "signalChain": [
    "NR",
    "FX1",
    "DRV",
    "AMP",
    "IR",
    "EQ",
    "FX2",
    "DLY",
    "RVB"
  ],
  "metadata": {
    "createdDate": "2026-08-18",
    "author": "PocketEdit",
    "tags": []
  }
}