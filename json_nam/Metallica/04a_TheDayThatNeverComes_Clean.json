{
  "version": "1.0",
  "presetName": "DayTDC C",
  "description": "The Day That Never Comes: soft clean rhythm with a bright American-style amp, subtle chorus, warm delay, and restrained room ambience",
  "ampMode": "Clone",
  "presetVolume": 100,
  "modules": {
    "NR": {
      "enabled": true,
      "effect": "Gate",
      "parameters": {
        "THRE": 9
      }
    },
    "FX1": {
      "enabled": false,
      "effect": "Boost",
      "parameters": {
        "Gain": 20,
        "+3dB": 1,
        "Bright": 1
      }
    },
    "DRV": {
      "enabled": false,
      "effect": "Scream",
      "parameters": {
        "Gain": 40,
        "Tone": 70,
        "Vol": 50
      }
    },
    "IR": {
      "enabled": true,
      "effect": "Jazz 2x12",
      "parameters": {
        "Vol": 100
      }
    },
    "EQ": {
      "enabled": true,
      "effect": "GT EQ 1",
      "parameters": {
        "125Hz": 0,
        "400Hz": 0,
        "800Hz": 0,
        "1.6kHz": 0,
        "4kHz": 0,
        "Vol": 100
      }
    },
    "FX2": {
      "enabled": true,
      "effect": "A-Chorus",
      "parameters": {
        "Depth": 25,
        "Rate": 0.4,
        "Tone": 58
      }
    },
    "DLY": {
      "enabled": true,
      "effect": "Warm",
      "parameters": {
        "Mix": 18,
        "Time": 430,
        "F.Back": 24
      }
    },
    "RVB": {
      "enabled": true,
      "effect": "Room",
      "parameters": {
        "Mix": 20,
        "Decay": 42
      }
    },
    "Clone": {
      "enabled": true,
      "effect": "TwinCln",
      "parameters": {
        "Gain": 50,
        "Vol": 100,
        "Bass": 50,
        "Middle": 50,
        "Treble": 50
      }
    }
  },
  "signalChain": [
    "NR",
    "FX1",
    "DRV",
    "AMP",
    "IR",
    "EQ",
    "FX2",
    "DLY",
    "RVB"
  ],
  "metadata": {
    "createdDate": "2026-08-18",
    "author": "PocketEdit",
    "tags": []
  }
}