{
  "version": "1.0",
  "presetName": "RealMe H",
  "description": "The Real Me: Townshend-inspired SG/P-90 punch with a tight, loud British amp-driven riff tone",
  "ampMode": "Clone",
  "presetVolume": 100,
  "modules": {
    "NR": {
      "enabled": true,
      "effect": "Gate",
      "parameters": {
        "THRE": 25
      }
    },
    "FX1": {
      "enabled": true,
      "effect": "Boost",
      "parameters": {
        "Gain": 18,
        "+3dB": 1,
        "Bright": 0
      }
    },
    "DRV": {
      "enabled": true,
      "effect": "Scream",
      "parameters": {
        "Gain": 22,
        "Tone": 53,
        "Vol": 54
      }
    },
    "IR": {
      "enabled": true,
      "effect": "BritGN 4x12",
      "parameters": {
        "Vol": 100
      }
    },
    "EQ": {
      "enabled": true,
      "effect": "GT EQ 1",
      "parameters": {
        "125Hz": 0,
        "400Hz": -3,
        "800Hz": 0,
        "1.6kHz": 2,
        "4kHz": 1,
        "Vol": 100
      }
    },
    "FX2": {
      "enabled": false,
      "effect": "Boost",
      "parameters": {
        "Gain": 20,
        "+3dB": 1,
        "Bright": 1
      }
    },
    "DLY": {
      "enabled": false,
      "effect": "Pure",
      "parameters": {
        "Mix": 20,
        "Time": 500,
        "F.Back": 30
      }
    },
    "RVB": {
      "enabled": true,
      "effect": "Room",
      "parameters": {
        "Mix": 10,
        "Decay": 34
      }
    },
    "Clone": {
      "enabled": true,
      "effect": "Plexi",
      "parameters": {
        "Gain": 50,
        "Vol": 100,
        "Bass": 50,
        "Middle": 50,
        "Treble": 50
      }
    }
  },
  "signalChain": [
    "NR",
    "FX1",
    "DRV",
    "AMP",
    "IR",
    "EQ",
    "FX2",
    "DLY",
    "RVB"
  ],
  "metadata": {
    "createdDate": "2026-08-18",
    "author": "PocketEdit",
    "tags": []
  }
}