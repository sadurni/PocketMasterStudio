{
  "version": "1.0",
  "presetName": "NoRain L",
  "description": "No Rain: warm melodic overdrive lead with light chorus, slapback reinforcement, and restrained room ambience  [Sub.: heavy rhythm -> Tones of Home]",
  "ampMode": "Clone",
  "presetVolume": 100,
  "modules": {
    "NR": {
      "enabled": true,
