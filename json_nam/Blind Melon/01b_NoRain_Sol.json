      "effect": "Boost",
      "parameters": {
        "Gain": 20,
        "+3dB": 1,
        "Bright": 1
      }
    },
    "DRV": {
      "enabled": true,
      "effect": "Butter OD",
      "parameters": {
        "Gain": 34,
        "Vol": 62
      }
    },
    "IR": {
      "enabled": true,
      "effect": "TWD 1x8",
      "parameters": {
        "Vol": 100
      }
    },
    "EQ": {
      "enabled": true,
      "effect": "GT EQ 1",
      "parameters": {
        "125Hz": -3,
        "400Hz": 1,
        "800Hz": 3,
        "1.6kHz": 4,
        "4kHz": 2,
        "Vol": 100
      }
    },
    "FX2": {
      "enabled": true,
      "effect": "A-Chorus",
