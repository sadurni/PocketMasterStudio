{
  "version": "1.0",
  "presetName": "Tones C",
  "description": "Tones of Home: compressed acoustic-style clean rhythm with a warm Fender-style amp for the song's open strumming",
  "ampMode": "Clone",
  "presetVolume": 100,
  "modules": {
    "NR": {
      "enabled": true,
      "effect": "Gate",
      "parameters": {
        "THRE": 8
      }
    },
    "FX1": {
      "enabled": true,
      "effect": "COMP 1",
      "parameters": {
        "Sustain": 38,
        "Vol": 54
      }
    },
    "DRV": {
      "enabled": false,
      "effect": "Scream",
      "parameters": {
        "Gain": 40,
        "Tone": 70,
        "Vol": 50
      }
    },
    "IR": {
      "enabled": true,
      "effect": "TWD 1x8",
      "parameters": {
        "Vol": 100
      }
    },
    "EQ": {
      "enabled": true,
      "effect": "GT EQ 1",
      "parameters": {
        "125Hz": -3,
        "400Hz": 0,
        "800Hz": 1,
        "1.6kHz": 2,
        "4kHz": 2,
        "Vol": 100
      }
    },
    "FX2": {
      "enabled": true,
      "effect": "A-Chorus",
      "parameters": {
        "Depth": 16,
        "Rate": 0.6,
        "Tone": 58
      }
    },
    "DLY": {
      "enabled": false,
      "effect": "Pure",
      "parameters": {
        "Mix": 20,
        "Time": 500,
        "F.Back": 30
      }
    },
    "RVB": {
      "enabled": true,
      "effect": "Room",
      "parameters": {
        "Mix": 12,
        "Decay": 35
      }
    },
    "Clone": {
      "enabled": true,
      "effect": "TwinCln",
      "parameters": {
        "Gain": 50,
        "Vol": 100,
        "Bass": 50,
        "Middle": 50,
        "Treble": 50
      }
    }
  },
  "signalChain": [
    "NR",
    "FX1",
    "DRV",
    "AMP",
    "IR",
    "EQ",
    "FX2",
    "DLY",
    "RVB"
  ],
  "metadata": {
    "createdDate": "2026-08-18",
    "author": "PocketEdit",
    "tags": []
  }
}