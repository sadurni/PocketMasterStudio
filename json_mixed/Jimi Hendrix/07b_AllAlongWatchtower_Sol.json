{
  "version": "1.0",
  "presetName": "Watch L",
  "description": "All Along the Watchtower: expressive melodic lead with reduced Fuzz Face intensity, gentle Vibe modulation, warm slapback, and spring reverb.",
  "ampMode": "Clone",
  "presetVolume": 100,
  "modules": {
    "NR": {
      "enabled": true,
      "effect": "Gate",
      "parameters": {
        "THRE": 20
      }
    },
    "FX1": {
      "enabled": true,
      "effect": "Vibe",
      "parameters": {
        "Depth": 35,
        "Rate": 0.8
      }
    },
    "DRV": {
      "enabled": true,
      "effect": "Grey Fuzz",
      "parameters": {
        "Fuzz": 48,
        "Vol": 78
      }
    },
    "IR": {
      "enabled": true,
      "effect": "BritGN 4x12",
      "parameters": {
        "Vol": 100
      }
    },
    "EQ": {
      "enabled": true,
      "effect": "GT EQ 1",
      "parameters": {
        "125Hz": -2,
        "400Hz": 1,
        "800Hz": 4,
        "1.6kHz": 4,
        "4kHz": 1,
        "Vol": 100
      }
    },
    "FX2": {
      "enabled": false,
      "effect": "Boost",
      "parameters": {
        "Gain": 20,
        "+3dB": 1,
        "Bright": 1
      }
    },
    "DLY": {
      "enabled": true,
      "effect": "Slap",
      "parameters": {
        "Mix": 19,
        "Time": 145,
        "F.Back": 18
      }
    },
    "RVB": {
      "enabled": true,
      "effect": "Spring",
      "parameters": {
        "Mix": 17,
        "Decay": 40
      }
    },
    "Clone": {
      "enabled": true,
      "effect": "Plexi",
      "parameters": {
        "Gain": 50,
        "Vol": 100,
        "Bass": 50,
        "Middle": 50,
        "Treble": 50
      }
    }
  },
  "signalChain": [
    "NR",
    "FX1",
    "DRV",
    "AMP",
    "IR",
    "EQ",
    "FX2",
    "DLY",
    "RVB"
  ],
  "metadata": {
    "createdDate": "2026-08-18",
    "author": "PocketEdit",
    "tags": []
  }
}