      "parameters": {
        "Gain": 18,
        "+3dB": 1,
        "Bright": 0
      }
    },
    "DRV": {
      "enabled": true,
      "effect": "Scream",
      "parameters": {
        "Gain": 20,
        "Tone": 54,
        "Vol": 73
      }
    },
    "IR": {
      "enabled": false,
      "effect": "BritGN 4x12",
      "parameters": {
        "Vol": 86
      }
    },
    "EQ": {
      "enabled": true,
      "effect": "GT EQ 2",
      "parameters": {
        "100Hz": -4,
        "500Hz": -2,
        "1kHz": 3,
        "3kHz": 5,
        "6kHz": 2,
        "Vol": 100
